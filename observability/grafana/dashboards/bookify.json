            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum((max_over_time(bookify_reservations_declined_total{show=~\"$show\",reason!=\"idempotent_replay\"}[$__range]) - ((bookify_reservations_declined_total{show=~\"$show\",reason!=\"idempotent_replay\"} offset $__range) or (max_over_time(bookify_reservations_declined_total{show=~\"$show\",reason!=\"idempotent_replay\"}[$__range]) * 0))))) or vector(0)",
          "legendFormat": ""
        }
      ]
