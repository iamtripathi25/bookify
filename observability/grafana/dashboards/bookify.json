    {
      "id": 205,
      "type": "stat",
      "title": "Contention declines (time range)",
      "description": "The database couldn't decide in time (lock timeout, pool wait, deadlock after retries). Should be 0; sustained values mean the pool or limits need tuning. Counted exactly from the raw counters; a restart inside the range undercounts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum((max_over_time(bookify_reservations_declined_total{show=~\"$show\",reason=\"contention\"}[$__range]) - ((bookify_reservations_declined_total{show=~\"$show\",reason=\"contention\"} offset $__range) or (max_over_time(bookify_reservations_declined_total{show=~\"$show\",reason=\"contention\"}[$__range]) * 0))))) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
