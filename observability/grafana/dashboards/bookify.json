{
  "uid": "bookify",
  "title": "Bookify",
  "tags": [
    "bookify"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 6,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 200,
      "type": "row",
      "title": "Reservations",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 201,
      "type": "stat",
      "title": "Seat invariant drift",
      "description": "Largest gap, across shows, between available + held + confirmed and the show's total seats. Must be 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(abs(sum by (show) (bookify_seats{show=~\"$show\"}) - on (show) bookify_show_seats{show=~\"$show\"})) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 202,
      "type": "stat",
      "title": "Reservations confirmed (time range)",
      "description": "Counted exactly from the raw counters; a restart inside the range undercounts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum((max_over_time(bookify_reservations_confirmed_total{show=~\"$show\"}[$__range]) - ((bookify_reservations_confirmed_total{show=~\"$show\"} offset $__range) or (max_over_time(bookify_reservations_confirmed_total{show=~\"$show\"}[$__range]) * 0))))) or vector(0)",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 203,
      "type": "stat",
      "title": "Declined (time range, excl. replays)",
      "description": "Counted exactly from the raw counters; a restart inside the range undercounts.",
