# Copy to .env and adjust. docker compose reads .env automatically.
DB_URL=jdbc:postgresql://postgres:5432/bookify
DB_USER=bookify
DB_PASSWORD=bookify
# At least 32 bytes. Generate with: openssl rand -base64 48
BOOKIFY_JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
# Enables POST /auth/token for minting test tokens (graders' burst tools need it).
BOOKIFY_DEV_AUTH_ENABLED=true
